# Copy this file to .env in this same directory and fill in your key.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it, never paste a key into chat, and never put one in
# source code. Anyone who gets the key can spend against your quota.
#
# Get a free key at https://aistudio.google.com/apikey — no card required.

GEMINI_API_KEY=

# Pinned on purpose. Aliases such as gemini-flash-latest can change or be overloaded
# between a rehearsal and a class; a pinned model cannot.
LLM_MODEL=gemini-3.5-flash-lite

# Gemini spends part of this budget reasoning before it writes anything, so a small value
# silently returns truncated answers rather than an error.
LLM_MAX_TOKENS=2000
